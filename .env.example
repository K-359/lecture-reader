# Claude API のキー（https://platform.claude.com で発行）
ANTHROPIC_API_KEY=

# 読み取りに使うモデル・effort・思考の有無（省略時: claude-haiku-5-5 / low / off）
# 思考を切れないモデル（claude-opus-5-5 など）にするときは READER_THINKING=on にする
# READER_MODEL=claude-haiku-5-5
# READER_EFFORT=low
# READER_THINKING=off

# API サーバーのポート（省略時: 8787）
# PORT=8787

# VOICEVOX エンジンの URL（省略時: http://localhost:50021）
# VOICEVOX_URL=http://localhost:50021
